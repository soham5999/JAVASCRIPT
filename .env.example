# ==============================================================================
# Antigravity Portfolio Analytics - Environment Configuration (.env.example)
# Rename this file to .env for local and production deployment
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# Authentication & Security
# Generate a cryptographically secure random secret (e.g., using `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_at_least_32_characters

# Initial Admin Credentials (used during first setup or seed script)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_password_min_8_chars

# Reverse Proxy Security
# Set to 'true' only if deployed behind a trusted reverse proxy (Vercel, Cloudflare, Nginx)
# When 'false', client-supplied X-Forwarded-For headers are rejected to prevent IP spoofing
TRUST_PROXY=false

# Privacy & Retention Configuration
# Raw IP collection is disabled by default ('false') to comply with privacy regulations
# When 'false', IPs are stored truncated (e.g. 192.168.1.xxx) or hashed
COLLECT_RAW_IP=false
DEFAULT_RETENTION_DAYS=60
IP_ANONYMIZE_MODE=truncate

# Database Storage Path (Defaults to ./data/analytics.db)
ANALYTICS_DB_DIR=./data
ANALYTICS_DB_PATH=./data/analytics.db

# Optional External Database (If switching from SQLite to PostgreSQL / Supabase)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

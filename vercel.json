{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "node_modules/geoip-lite/data/**",
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
